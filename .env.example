# Copy to .env and fill in. All providers below have free tiers; limits change
# often, so verify current quotas before planning an N=5 run over 300 items.

# Primary. Create at https://aistudio.google.com/apikey (free, no card).
# Free tier is ~15 requests/min and 1500/day for gemini-2.0-flash; the pacing
# in eval/configs/default.yaml assumes that, so re-check it before a long run.
GEMINI_API_KEY=
GROQ_API_KEY=          # Groq - fast batch, good for consistency runs
OPENROUTER_API_KEY=    # OpenRouter :free models - cross-model comparison
OLLAMA_API_KEY=ollama  # local Ollama ignores the value but the client wants one
